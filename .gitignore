# Environment variables
.env

# Legacy backup (archived old Bahmni-based configuration)
_backup_legacy/

# OHIF configuration (OHIF is now integrated into Orthanc via plugin)
ohif/

# Orthanc MWL: worklist files dropped at runtime (track worklists/.gitkeep only)
orthanc/worklists/*.wl

# OpenELIS logs
openelis/volume/logs/


# OpenELIS runtime config (written by container, would expose internal config if committed)
openelis/volume/properties/TotalSystemConfiguration.properties
openelis/volume/properties/SystemConfiguration.properties
openelis/volume/properties/ChangedSystemConfiguration.properties
openelis/volume/configuration/backend/ocl-checksums.properties
openelis/volume/configuration/backend/tests-checksums.properties

# Middleware build artifacts (JAR files)
middleware/*/target/
middleware/*/target/**
*.jar
# But keep the target directories themselves
!middleware/*/target/
!middleware/*/target/.gitkeep

**/.DS_Store

# Python bytecode cache (e.g. superset/__pycache__ from init_superset_metadata.py)
__pycache__/
*.py[cod]

gateway-truststore.p12
gateway.pem
OpenELIS-Global.war
.gstack/

# Local dev compose override (host addon binds)
docker-compose.override.yml

# Local backup artefacts and resolved configs — contain patient data and secrets.
# Never commit these.
backups
env-resolved
docker-compose-resolved
*-resolved
