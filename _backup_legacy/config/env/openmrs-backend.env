TZ=${DEFAULT_TIMEZONE}
OMRS_DB=postgresql
OMRS_DB_HOSTNAME=openmrs-db
OMRS_DB_PORT=5432
OMRS_DB_NAME=${OPENMRS_DB_NAME}
OMRS_DB_USERNAME=${OPENMRS_DB_USER}
OMRS_DB_PASSWORD=${OPENMRS_DB_PASSWORD}
OMRS_DB_ARGS=?ssl=false
OMRS_CONFIG_CONNECTION_DRIVER_CLASS=org.postgresql.Driver
OMRS_CONFIG_CONNECTION_URL=jdbc:postgresql://openmrs-db:5432/${OPENMRS_DB_NAME}
OMRS_CONFIG_CONNECTION_USERNAME=${OPENMRS_DB_USER}
OMRS_CONFIG_CONNECTION_PASSWORD=${OPENMRS_DB_PASSWORD}
OMRS_CONFIG_CREATE_TABLES=true
OMRS_CONFIG_AUTO_UPDATE_DATABASE=true
OMRS_CONFIG_MODULE_WEB_ADMIN=true

