# Docker Compose Variables
COMPOSE_PROFILES= core, elis, odoo,reports
NIDAN_HOME_HOST=localhost


# Postgres / Odoo Database
#DB_HOST=odoo-db
#DB_PORT=5432
#ODOO_DB_NAME=odoo
#ODOO_DB_USER=odoo
#ODOO_DB_PASSWORD=odoo

# Odoo Addons
ODOO_ADDONS=/mnt/extra-addons

# Timezone
DEFAULT_TIMEZONE=Asia/Kathmandu

#Proxy
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_EMAIL=admin@example.org
TRAEFIK_ACME_STAGING=false
TRAEFIK_DASHBOARD_HOST=proxy.localhost

#OPENMRS_IMAGE_TAG=qa

OPENMRS_HOST=localhost
#OPENMRS_DB_NAME=openmrs
#OPENMRS_DB_USER=openmrs


#OPENELIS_HOST=lis.local
#OPENELIS_DB_NAME=openelis
#OPENELIS_DB_USER=openelis
#OPENELIS_DB_PASSWORD=changeMeOpenELIS!

ODOO_HOST=odoo.localhost
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=changeMeOdoo!
ODOO_ADDONS=sale_management,stock,account_account,purchase,mrp,odoo_initializer,mrp_product_expiry,product_expiry,l10n_generic_coa
ODOO_INITIALIZER_DATA_FILES_PATH=
ODOO_CONFIG_PATH=
ODOO_INITIALIZER_CONFIG_FILE_PATH=
ODOO_DATABASE=odoo

BAHMNI_REPORTS_HOST=reports.localhost
BAHMNI_REPORTS_DB_NAME=bahmni_reports
BAHMNI_REPORTS_DB_USER=bahmni_reports
BAHMNI_REPORTS_DB_PASSWORD=changeMeReports!

DEFAULT_TIMEZONE=Asia/Kathmandu

#Bahmni Reports
OPENMRS_URL=https://${OPENMRS_HOST}/openmrs
OPENMRS_USER=reports
#OPENMRS_PASSWORD=changeMeReportsUser!
REPORTS_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
REPORTS_DB_URL=jdbc:postgresql://openmrs-db:5432/${BAHMNI_REPORTS_DB_NAME}
REPORTS_DB_USERNAME=${BAHMNI_REPORTS_DB_USER}
REPORTS_DB_PASSWORD=${BAHMNI_REPORTS_DB_PASSWORD}
TZ=${DEFAULT_TIMEZONE}
