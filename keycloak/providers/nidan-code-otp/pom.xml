<?xml version="1.0" encoding="UTF-8"?>
<!-- Nidan email / SMS sign-in codes for Keycloak (optional second step, user decision 2026-10-12).
     Build: mvn -q package (needs network) or ./build.sh (offline, runs the self-check) -> target/nidan-code-otp.jar,
     copied to ../dist (mounted into /opt/keycloak/providers). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.nidan.keycloak</groupId>
  <artifactId>nidan-code-otp</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- must match the Keycloak image in docker-compose.yml -->
    <keycloak.version>26.8.0</keycloak.version>
  </properties>

  <dependencies>
    <dependency><groupId>org.keycloak</groupId><artifactId>keycloak-server-spi</artifactId><version>${keycloak.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.keycloak</groupId><artifactId>keycloak-server-spi-private</artifactId><version>${keycloak.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.keycloak</groupId><artifactId>keycloak-services</artifactId><version>${keycloak.version}</version><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <finalName>nidan-code-otp</finalName>
  </build>
</project>
