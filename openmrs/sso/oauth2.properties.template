# oauth2login for OpenMRS (backlog KC-34, spec 6.1). Rendered by startup-custom.sh into the application data
# directory only when central login is on. @VAR@ placeholders come from the container environment.
#
# Browser goes to the public Keycloak URL; token, userinfo and signing keys go through the gateway's internal
# back-channel (KC-43), which is the only way this container can reach Keycloak.
clientId=openmrs
clientSecret=@KC_OPENMRS_CLIENT_SECRET@
scope=openid profile email
userAuthorizationUri=@KEYCLOAK_PUBLIC_URL@/realms/nidan/protocol/openid-connect/auth
accessTokenUri=http://gateway:8099/auth/realms/nidan/protocol/openid-connect/token
userInfoUri=http://gateway:8099/auth/realms/nidan/protocol/openid-connect/userinfo
keysUrl=http://gateway:8099/auth/realms/nidan/protocol/openid-connect/certs
keysTtlSeconds=300
# Logout ends the OpenMRS session, then the gateway session and the Keycloak session (spec 4 rule 7).
logoutUri=https://@GATEWAY_DOMAIN@/oauth2/sign_out?rd=/
#
# User / person mappings from the userinfo response (realm client "openmrs").
openmrs.mapping.user.username=preferred_username
openmrs.mapping.person.givenName=given_name
openmrs.mapping.person.familyName=family_name
openmrs.mapping.person.gender=gender
openmrs.mapping.user.email=email
openmrs.mapping.user.systemId=sub
openmrs.mapping.user.roles=roles
#
# Machine callers (client-credentials Bearer tokens, KC-58-01): only these clients, only this issuer.
openmrs.mapping.user.username.serviceAccount=openmrs_user
openmrs.serviceAccount.allowedClients=cis,odoo-sync,portal-sync
openmrs.serviceAccount.issuer=@KEYCLOAK_PUBLIC_URL@/realms/nidan
# Machine tokens must be meant for OpenMRS (realm audience mapper aud=openmrs, KC-01-03).
openmrs.serviceAccount.audience=openmrs
