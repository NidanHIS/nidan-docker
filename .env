# Shared gateway / TLS (Let's Encrypt via certbot)
GATEWAY_DOMAIN=localhost
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAINS=localhost

# OpenELIS
OPENELIS_DOMAIN=localhost
OPENELIS_DB_NAME=clinlims
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=clinlims
OPENELIS_DEFAULT_ADMIN_PASSWORD=adminADMIN!
OPENELIS_TZ=UTC

# Optional keystore/truststore paths (used by FHIR)
SSL_TRUSTSTORE_PATH=
SSL_TRUSTSTORE_PASSWORD=
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# OpenMRS
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=root
OPENMRS_DB_HOST=openmrs-db

# Odoo
ODOO_DB_NAME=nidan
ODOO_DB_USER=nidan
ODOO_DB_PASSWORD=nidan
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_DB=postgres
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_ADMIN_EMAIL=nidan
ODOO_ADMIN_PASSWORD=nidan

# Nidan OIS integration for Odoo
NIDAN_OIS_URL=http://nidan-ois:8082
NIDAN_OIS_SECRET=change-me
# Note: Update NIDAN_OIS_URL if you change OIS_PORT

# Extra addons mount for dev (host path for custom Odoo addons)
ODOO_EXTRA_ADDONS_HOST_PATH=../odoo_19_addons

# Keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_RELATIVE_PATH=/auth

# Orthanc
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=orthanc
ORTHANC_DB_HOST=orthanc-db
ORTHANC_USERNAME=nidan
ORTHANC_PASSWORD=nidan
ORTHANC_DICOM_UID_ROOT=1.2.840.10008

# Integration Middleware Database
INTEGRATION_DB_NAME=nidan_integration
INTEGRATION_DB_USER=nidan
INTEGRATION_DB_PASSWORD=nidan
INTEGRATION_DB_HOST=nidan-integration-db
INTEGRATION_DB_PORT=5432

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ZOOKEEPER_CONNECT=nidan-zookeeper:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# Zookeeper Configuration
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# CIS Configuration
CIS_KAFKA_GROUP_ID=nidan-cis
CIS_PORT=8081
OPENMRS_ENABLED=true
OPENMRS_BASE_URL=http://openmrs-backend:8080/openmrs
ORTHANC_ENABLED=true
ORTHANC_BASE_URL=http://orthanc:8042
INTEGRATION_SOURCE_SYSTEM=CIS
INTEGRATION_SKIP_SOURCE_SYSTEMS=OPENMRS

# OIS Configuration
OIS_KAFKA_GROUP_ID=nidan-ois
OIS_PORT=8082
OIS_WEBHOOK_SECRET=change-me-secret-key
ODOO_BASE_URL=http://odoo:8069
SKIP_SOURCE_SYSTEMS_FOR_ODOO=ODOO

# OpenMRS Integration Config
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
OPENMRS_IDENTIFIER_TYPE_UUID=05a29f94-c0ed-11e2-94be-8c13b969e334
OPENMRS_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
OPENMRS_FHIR_EXTENSION_URL=http://fhir.openmrs.org/ext/patient/identifier#location

# Odoo Integration Config
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
ODOO_POS_ORDER_REF_PREFIX=RAD-
ODOO_POS_DEFAULT_RADIOLOGY_PRODUCT_ID=1

# Radiology Order Config
RADIOLOGY_ACCESSION_PREFIX=RAD-
RADIOLOGY_PROCEDURE_CODE_PREFIX=RAD-
