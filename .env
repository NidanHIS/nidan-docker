# ─────────────────────────────────────────────────────────────────────────────
#  DEMO CONFIGURATION — EVERY VALUE IN THIS FILE IS PUBLIC
#
#  This file is committed on purpose, so that `git clone && docker compose up`
#  works for anyone evaluating the stack. That is a deliberate trade.
#
#  It also means: never put a real credential here. Adding this file to
#  .gitignore does NOT protect it — .gitignore has no effect on a file git is
#  already tracking, and .env has been tracked since the first commit. Edit it
#  with a real secret and the next `git add -A` stages that secret.
#
#  FOR A REAL DEPLOYMENT, put overrides in .env.local, which is untracked:
#
#      cp env.template .env.local        # then fill in every CHANGEME
#      COMPOSE_ENV_FILES=.env,.env.local docker compose up -d
#
#  Set NIDAN_DEPLOYMENT=production in .env.local and the services refuse to
#  start on any value still shipped here, not just on CHANGEME.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# Nidan Docker — local .env (see env.template for documentation)
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway & TLS (Let's Encrypt via certbot)
# -----------------------------------------------------------------------------
# Local build for testing (docker build -t nidan/gateway:local ./proxy).
# Revert to trigonaltechnology/gateway:latest (or :stable) for prod.
GATEWAY_IMAGE=trigonaltechnology/gateway:latest
GATEWAY_DOMAIN=localhost
DASHBOARD_ODOO_URL=https://demo-odoo.nidanehr.com
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAINS=localhost
GATEWAY_CERT_SANS=

# Docker Compose Variables
COMPOSE_PROFILES=nidanehr-standard


# -----------------------------------------------------------------------------
# TLS trust / keystores (optional; FHIR or HTTPS clients)
# -----------------------------------------------------------------------------
SSL_TRUSTSTORE_PATH=
SSL_TRUSTSTORE_PASSWORD=
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# -----------------------------------------------------------------------------
# OpenMRS — MySQL + EMR API (CIS uses DB host for Debezium; REST below)
# -----------------------------------------------------------------------------
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=openmrs
OPENMRS_DB_HOST=openmrs-db
OPENMRS_DB_PORT=3306
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=1GB
OMRS_DEBUG=false

# OpenMRS O3 SPA image build (nidan-docker/openmrs/frontend/Dockerfile)
# Default Dockerfile includes @nidan/esm-nepali-calendar (BS calendar).
# For vanilla upstream date pickers: docker build -f Dockerfile.vanilla ...
NIDAN_CALENDAR_BUNDLE=1.0.0-v9   # bump Dockerfile ARG after repacking the tgz

# CIS authenticates/writes to OpenMRS AS the sync account (loop prevention). = NIDAN_SYNC_*.
OPENMRS_USERNAME=nidan-sync
OPENMRS_PASSWORD=Nidan@123
# Real OpenMRS admin — used only by nidan-provisioner to create the sync account.
OPENMRS_ADMIN_USERNAME=admin
OPENMRS_ADMIN_PASSWORD=Admin123
# Dedicated integration sync service account (provisioned into all systems).
NIDAN_SYNC_USERNAME=nidan-sync
NIDAN_SYNC_PASSWORD=Nidan@123
OPENMRS_IDENTIFIER_TYPE_UUID=c0e1d2f3-a4b5-4c6d-9e0f-1a2b3c4d5e6f
OPENMRS_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
OPENMRS_FHIR_EXTENSION_URL=http://fhir.openmrs.org/ext/patient/identifier#location
# Encounter type for order-less (Odoo-billed / walk-in) lab results ingested from OpenELIS ("Lab Results")
OPENMRS_LAB_RESULTS_ENCOUNTER_TYPE_UUID=3596fafb-6f6f-4396-8c87-6e63a0f1bd71
# Concept set whose members O3 lists as orderable lab tests; CIS catalog sync adds new tests here ("Tests Orderability")
OPENMRS_LAB_ORDERABLES_CONCEPT_SET_UUID=1748a953-d12e-4be1-914c-f6b096c6cdef

# order_type UUIDs (Initializer ordertypes.csv); CIS resolves to order_type_id at startup
OPENMRS_ORDER_TYPE_UUID_DRUG=131168f4-15f5-102d-96e4-000c29c2a5d7
OPENMRS_ORDER_TYPE_UUID_LAB=52a447d3-a64a-11e3-9aeb-50e549534c5e
OPENMRS_ORDER_TYPE_UUID_RADIOLOGY=c19c8e82-8b8d-4b4e-b1ff-3f09890b2db3
OPENMRS_ORDER_TYPE_UUID_PROCEDURE=4237a01f-29c5-4167-9d8e-96d6e590aa33
OPENMRS_ORDER_TYPE_UUID_MEDICAL_SUPPLY=dab3ab30-2feb-48ec-b4af-8332a0831b49
OPENMRS_ORDER_TYPE_UUID_BED=e8c4fd91-4b0a-4f2c-9d8e-1a2b3c4d5e6f

# -----------------------------------------------------------------------------
# Orthanc — PostgreSQL + DICOM server (HTTP basic for Orthanc UI / CIS)
# Web UI: direct http://localhost:8042/ or via gateway http://localhost/orthanc-container/ (not http://orthanc:8042).
# Login: ORTHANC_USERNAME / ORTHANC_PASSWORD. Explorer 2: .../ui/app/
# -----------------------------------------------------------------------------
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=orthanc
ORTHANC_DB_HOST=orthanc-db
ORTHANC_USERNAME=nidan
ORTHANC_PASSWORD=nidan
ORTHANC_DICOM_UID_ROOT=1.2.840.10008

# -----------------------------------------------------------------------------
# OpenELIS — app + DB + CIS REST client
# -----------------------------------------------------------------------------
OPENELIS_DOMAIN=localhost
OPENELIS_DB_NAME=clinlims
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=clinlims
OPENELIS_DEFAULT_ADMIN_PASSWORD=adminADMIN!
OPENELIS_TZ=UTC

OPENELIS_ENABLED=true
OPENELIS_BASE_URL=http://openelis:8080/OpenELIS-Global/rest
OPENELIS_USERNAME=admin
OPENELIS_PASSWORD=adminADMIN!

# OpenELIS ← CIS middleware sync (JVM -D props injected via CATALINA_OPTS)
CIS_BASE_URL=http://nidan-cis:8081
OPENELIS_MIDDLEWARE_TEST_SYNC_ENABLED=true
OPENELIS_MIDDLEWARE_RESULT_SYNC_ENABLED=true
OPENELIS_NIDAN_TESTORDER_ENABLED=true
OPENELIS_MIDDLEWARE_SYNC_SECRET=change-me
OPENELIS_NIDAN_PAYWALL_ENABLED=true
NIDANCORE_ODOO_URL=http://odoo:8069
OPENELIS_NIDAN_PAYWALL_INSURANCE_BYPASS=true

# -----------------------------------------------------------------------------
# Odoo — PostgreSQL + app + OIS bridge
# -----------------------------------------------------------------------------
ODOO_DB_NAME=nidan
ODOO_DB_USER=nidan
ODOO_DB_PASSWORD=nidan
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_DB=postgres
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_ADMIN_EMAIL=nidan
ODOO_ADMIN_PASSWORD=nidan
ODOO_WEB_BASE_URL=http://localhost:8069
ODOO_WEB_BASE_URL_FREEZE=True
ODOO_ADDONS_PATH=../odoo_19_addons

# Local addon source mounted live into the odoo container (paths are relative to nidan-docker/).
# Open-source addons -> /mnt/extra-addons ; closed-source addons -> /mnt/private-addons.
# Editing these host trees + recreating odoo (with the compose `-u all`) deploys local changes.

NIDAN_OIS_URL=http://nidan-ois:8082
NIDAN_OIS_SECRET=sample

ODOO_USERNAME=nidan
ODOO_PASSWORD=nidan

NIDAN_ODOO_SECRET=sample
ODOO_NIDAN_SECRET=sample
OIS_WEBHOOK_SECRET=sample

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_RELATIVE_PATH=/auth

# -----------------------------------------------------------------------------
# Nidan middleware PostgreSQL (CIS + OIS)
# -----------------------------------------------------------------------------
INTEGRATION_DB_NAME=nidan_integration
INTEGRATION_DB_USER=nidan
INTEGRATION_DB_PASSWORD=nidan
INTEGRATION_DB_HOST=nidan-integration-db
INTEGRATION_DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis — visit sync echo lock (CIS + OIS spring.data.redis); stack may omit Redis (apps degrade).
# false = do not ping Redis in /actuator/health (avoids WARN when broker is absent).
# true = include Redis in health when you run a Redis service and set REDIS_HOST / REDIS_PORT.
# -----------------------------------------------------------------------------
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# -----------------------------------------------------------------------------
# Zookeeper & Kafka
# -----------------------------------------------------------------------------
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ZOOKEEPER_CONNECT=nidan-zookeeper:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# Optional: broker / ZooKeeper JVM and threading (docker-compose nidan-kafka / nidan-zookeeper).
# KAFKA_HEAP_OPTS=-Xmx768m -Xms768m
# KAFKA_JVM_PERFORMANCE_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:+ExitOnOutOfMemoryError
# ZOOKEEPER_HEAP_OPTS=-Xmx256m -Xms256m
# KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=3000
# KAFKA_NUM_NETWORK_THREADS=8
# KAFKA_NUM_IO_THREADS=8

# Optional: Spring Kafka client timeouts (CIS/OIS application.yml). Uncomment to tune without rebuild.
# KAFKA_CONSUMER_REQUEST_TIMEOUT_MS=120000
# KAFKA_CONSUMER_SESSION_TIMEOUT_MS=45000
# KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=15000
# KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=120000
# KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# CIS (nidan-cis)
# -----------------------------------------------------------------------------
NIDAN_CIS_IMAGE=trigonaltechnology/nidan-cis:latest
CIS_PORT=8081
CIS_KAFKA_GROUP_ID=nidan-cis

OPENMRS_ENABLED=true
OPENMRS_BASE_URL=http://openmrs-backend:8080/openmrs
ORTHANC_ENABLED=true
ORTHANC_BASE_URL=http://orthanc:8042
ORTHANC_WORKLIST_DIR=/var/lib/orthanc/worklists
DICOM_TYPE=orthanc

INTEGRATION_SOURCE_SYSTEM=CIS
INTEGRATION_SKIP_SOURCE_SYSTEMS=OPENMRS
RADIOLOGY_ACCESSION_PREFIX=RAD-
RADIOLOGY_PROCEDURE_CODE_PREFIX=RAD-

INTEGRATION_FLOW_RADIOLOGY_MWL_ENABLED=true
INTEGRATION_FLOW_RADIOLOGY_POS_ENABLED=true
INTEGRATION_FLOW_LAB_OPENELIS_ENABLED=true
INTEGRATION_FLOW_LAB_POS_ENABLED=true
# OpenELIS → OpenMRS result ingestion (CIS). Leave UNSET to follow OPENMRS_ENABLED
# (auto-off for lab+billing-only deployments). Set explicitly to override, e.g. keep
# OpenMRS on but result-sync off: INTEGRATION_FLOW_LAB_RESULTS_OPENMRS_ENABLED=false
# INTEGRATION_FLOW_LAB_RESULTS_OPENMRS_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_LAB_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_RADIOLOGY_ENABLED=true

DEBEZIUM_ENABLED=true
DEBEZIUM_DB_USER=root
DEBEZIUM_DB_PASSWORD=openmrs
DEBEZIUM_TABLE_INCLUDE_LIST=openmrs.visit,openmrs.orders,openmrs.drug_order,openmrs.person,openmrs.person_name,openmrs.patient_identifier,openmrs.bed_type,openmrs.bed_patient_assignment_map,openmrs.location,openmrs.provider,openmrs.provider_attribute

# Kafka retry + DLT: exhausted failures are stored in Postgres (dead_letter) with admin-readable summaries.
# No extra env vars for that — uses INTEGRATION_DB_* already. Inspect: GET /api/dead-letters on nidan-cis (CIS_PORT) and nidan-ois (OIS_PORT).
INTEGRATION_KAFKA_RETRY_ENABLED=true
INTEGRATION_KAFKA_RETRY_ATTEMPTS=5
INTEGRATION_KAFKA_RETRY_INITIAL_DELAY=5s
INTEGRATION_KAFKA_RETRY_MULTIPLIER=2.0
INTEGRATION_KAFKA_RETRY_MAX_DELAY=10m
CIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-cis-retry
CIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.cis.DLT

# -----------------------------------------------------------------------------
# OIS (nidan-ois)
# -----------------------------------------------------------------------------
NIDAN_OIS_IMAGE=trigonaltechnology/nidan-ois:latest
OIS_PORT=8082
OIS_KAFKA_GROUP_ID=nidan-ois
ODOO_BASE_URL=http://odoo:8069
SKIP_SOURCE_SYSTEMS_FOR_ODOO=ODOO

OIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-ois-retry
OIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.ois.DLT

