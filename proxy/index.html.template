<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NidanEHR Services Portal</title>
  <style>
    /* ==========================================================================
       1. Global Styles & CSS Variables
       ========================================================================== */
    :root {
      --bg-color: #dbe3ea;
      --card-bg: #ffffff;
      --card-hover-bg: #f8fafc;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --primary-teal: #008080;
      
      --footer-bg: #008080;
      --footer-text: #ffffff;
      --footer-muted: rgba(255, 255, 255, 0.85);

      --status-online: #10b981;
      --status-checking: #f59e0b;
      --border-color: #e2e8f0;
      --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.03);
      --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
      width: 100%;
    }

    main {
      padding: 1rem 0 2rem;
      flex-grow: 1;
    }

    /* ==========================================================================
       2. Centered Clean Header
       ========================================================================== */
    .header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      width: 100%;
      margin: 10px 0 15px;
      background: transparent;
      padding: 0;
      box-shadow: none;
      border: none;
    }

    .brand-logo {
      width: 95px;
      height: auto;
      flex-shrink: 0;
      filter: none;
    }

    .header-content {
      text-align: left;
      border-left: none;
      padding-left: 0;
    }

    .header-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--primary-teal);
      margin-bottom: 2px;
      text-transform: none;
      letter-spacing: normal;
    }

    .header-sub {
      font-size: 0.95rem;
      font-weight: 600;
      color: #334155;
    }

    .header-sub-2 {
      font-size: 0.85rem;
      color: #64748b;
      margin-top: 1px;
    }

    .header-location {
      font-size: 1.25rem;
      font-weight: 700;
      margin-top: 4px;
      color: #222;
    }

    .alt-location {
      color: #777;
      margin-top: 1px;
      font-size: 0.85rem;
    }

    @media (max-width: 768px) {
      .header {
        flex-direction: column;
        text-align: center;
        gap: 10px;
        margin: 15px 0;
      }

      .header-content {
        text-align: center;
        border-top: none;
        padding-top: 0;
      }

      .brand-logo {
        max-width: 85px;
      }
    }

    /* ==========================================================================
       3. Hero & Square Cards Grid Layout
       ========================================================================== */
    .hero-container {
      text-align: center;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 1.65rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.025em;
      line-height: 1.25;
      position: relative;
      display: inline-block;
    }

    .hero-title::after {
      content: '';
      display: block;
      width: 50px;
      height: 3px;
      background-color: var(--primary-teal);
      border-radius: 2px;
      margin: 0.5rem auto 0;
    }

    /* Hide Welcome Title on displays <= 12 inches (~1024px screen width) */
    @media (max-width: 1440px) {
      .hero-container {
        display: none !important;
      }
    }

    /* Strict 4-column grid layout */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      max-width: 1080px;
      margin: 0 auto;
    }

    /* Square Card Configuration */
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      border: 1px solid transparent;
      box-shadow: var(--shadow-sm);
      transition: var(--transition-smooth);
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      aspect-ratio: 1 / 1;
      width: 100%;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: rgba(0, 128, 128, 0.2);
      background: var(--card-hover-bg);
    }

    /* Status Badges */
    .status-badge {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      margin-bottom: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .status-badge.status-checking {
      background-color: rgba(245, 158, 11, 0.1);
      color: var(--status-checking);
    }

    .status-badge.status-online {
      background-color: rgba(16, 185, 129, 0.1);
      color: var(--status-online);
    }

    .icon-wrapper {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.5rem;
      transition: var(--transition-smooth);
    }

    .card:hover .icon-wrapper {
      transform: scale(1.06);
    }

    .icon-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .card-title {
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.25;
      margin-bottom: 0.25rem;
    }

    .card-description {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.2;
    }

    /* --------------------------------------------------------------------------
       Spacious Layout for Desktop/Large Screens (>= 1025px)
       -------------------------------------------------------------------------- */
    @media (min-width: 1025px) {
      main {
        padding: 2rem 0 3.5rem;
      }

      .header {
        margin-bottom: 2rem;
      }

      .hero-container {
        margin-bottom: 3rem;
      }
    }

    /* Responsive scaling for mobile & tablets */
    @media (max-width: 900px) {
      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 550px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }
      .card {
        aspect-ratio: auto;
        padding: 1.25rem 1rem;
      }
    }

    /* ==========================================================================
       4. Footer Styles
       ========================================================================== */
    footer {
      background-color: var(--footer-bg);
      padding: 1rem 0;
      color: var(--footer-text);
      font-size: 0.85rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .footer-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 0.25rem;
      flex-shrink: 0;
    }

    .footer-brand-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
      color: inherit;
    }

    .footer-logo {
      height: 1em;
      width: auto;
      display: inline-block;
      vertical-align: middle;
    }

    .tech-powerhouse {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .tech-powerhouse-title {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--footer-text);
    }

    .tech-list-small {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: nowrap;
    }

    .tech-logo-small {
      max-height: 14px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
      opacity: 0.85;
      transition: var(--transition-smooth);
    }

    .tech-logo-small:hover {
      opacity: 1;
      transform: scale(1.1);
    }

    .copyright-text {
      color: var(--footer-muted);
      font-size: 0.75rem;
    }

    @media (max-width: 768px) {
      .footer-content {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
      }

      .footer-left,
      .footer-right {
        align-items: center;
        text-align: center;
      }

      .tech-list-small {
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <!-- Main Content Area -->
  <main>
    <div class="container">
      
      <!-- Side-by-Side Centered Header -->
      <header class="header">
        <img src="/assets/images/nepal-gov-logo.png" alt="Nepal Government Logo" class="brand-logo">
        <div class="header-content">
          <div class="header-title">Lumbini Province Government</div>
          <div class="header-sub">Ministry of Health</div>
          <div class="header-sub-2">Health Directorate</div>
          <div class="header-location">Bhalubang Hospital</div>
          <div class="alt-location">Bhalubang, Dang</div>
        </div>
      </header>

      <!-- Hero Section (Hidden on screens <= 12 inches) -->
      <div class="hero-container">
        <h1 class="hero-title">Welcome to NidanEHR Services Portal</h1>
      </div>

      <!-- Grid of Services -->
      <div class="cards-grid">

        <!-- Row 1: Cards 1 to 4 -->
        <a href="${DASHBOARD_ODOO_URL}" target="_blank" class="card" id="card-odoo">
          <div class="status-badge status-checking" id="status-odoo">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/billing.png" alt="Patient Registration & Billing Icon" />
          </div>
          <h2 class="card-title">Patient Registration & Billing</h2>
        </a>

        <a href="/openmrs/spa/index.html" target="_blank" class="card" id="card-openmrs">
          <div class="status-badge status-checking" id="status-openmrs">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/emr.png" alt="Electronic Health Record Icon" />
          </div>
          <h2 class="card-title">Electronic Health Record</h2>
        </a>

        <a href="/openelis" target="_blank" class="card" id="card-openelis">
          <div class="status-badge status-checking" id="status-openelis">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/lab.png" alt="Laboratory Information System Icon" />
          </div>
          <h2 class="card-title">Laboratory Information System</h2>
        </a>

        <a href="/orthanc-container/ui/app/index.html#/" target="_blank" class="card" id="card-orthanc">
          <div class="status-badge status-checking" id="status-orthanc">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/pacs.png" alt="PACS & Diagnostic Imaging Icon" />
          </div>
          <h2 class="card-title">Radiology & Diagnostic Imaging</h2>
        </a>

        <!-- Row 2: Cards 5 to 7 -->
        <a href="/cis/dead-letters/index.html" target="_blank" class="card" id="card-cis">
          <div class="status-badge status-checking" id="status-cis">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/crisis.png" alt="Integration & Error Management Icon" />
          </div>
          <h2 class="card-title">Integration & Error Management</h2>
          <p class="card-description">Integration & eemps error data</p>
        </a>

        <a href="/superset/" target="_blank" class="card" id="card-superset">
          <div class="status-badge status-checking" id="status-superset">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/analytics.png" alt="Analytics & Business Intelligence Icon" />
          </div>
          <h2 class="card-title">Analytics & Business Intelligence</h2>
        </a>

        <a href="/dhis2/" target="_blank" class="card" id="card-dhis2">
          <div class="status-badge status-checking" id="status-dhis2">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/dhis2-report.png" alt="HMIS Reporting Icon" />
          </div>
          <h2 class="card-title">Federal & Provincial HMIS Reporting</h2>
        </a>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container footer-content">
      
      <!-- Left Side: Single Line Open Source Powerhouse Logos -->
      <div class="footer-left">
        <div class="tech-powerhouse">
          <span class="tech-powerhouse-title">Open Source Powerhouse</span>
          <div class="tech-list-small">
            <img src="/assets/images/openmrs_logo.svg" alt="OpenMRS" class="tech-logo-small" />
            <img src="/assets/images/OpenElisGlobalLogo.png" alt="OpenELIS Global" class="tech-logo-small" />
            <img src="/assets/images/dhis2-logo.svg" alt="DHIS2" class="tech-logo-small" />
            <img src="/assets/images/OrthancLogo.png" alt="Orthanc" class="tech-logo-small" />
            <img src="/assets/images/odoo_logo.svg" alt="Odoo" class="tech-logo-small" />
          </div>
        </div>
      </div>

      <!-- Right Side: Powered By & Copyright -->
      <div class="footer-right">
        <span>
          Powered by 
          <a href="https://trigonaltechnology.com/" target="_blank" class="footer-brand-link">
            <img src="trigonal-logo.png" alt="Trigonal Technology" class="footer-logo">
            <strong>Trigonal Technology</strong>
          </a>
        </span>
        <span class="copyright-text">© 2026 NidanEHR. All rights reserved.</span>
      </div>

    </div>
  </footer>

  <script>
      const services = [
          { id: 'openmrs', url: '/openmrs/spa/config.json' },
          { id: 'openelis', url: '/openelis/' },
          { id: 'odoo', url: '/odoo-health/' },
          { id: 'orthanc', url: '/auth-ping/orthanc' },
          { id: 'cis', url: '/cis/actuator/health' },
          { id: 'superset', url: '/superset/' },
          { id: 'dhis2', url: '/dhis2/auth/login' }
      ];

      async function checkHealth() {
          for (const service of services) {
              const card = document.getElementById(`card-${service.id}`);
              const statusBadge = document.getElementById(`status-${service.id}`);
              if (!card || !statusBadge) continue;

              try {
                  const response = await fetch(service.url, { method: 'GET', cache: 'no-cache' });
                  if (response.status === 502 || response.status === 503 || response.status === 504) {
                      setOffline(card, statusBadge);
                  } else {
                      setOnline(card, statusBadge);
                  }
              } catch (error) {
                  setOffline(card, statusBadge);
              }
          }
      }

      function setOnline(card, badge) {
          card.classList.remove('offline');
          badge.className = 'status-badge status-online';
          badge.innerText = 'Online';
      }

      function setOffline(card, badge) {
          card.classList.add('offline');
          badge.className = 'status-badge status-offline';
          badge.innerText = 'Offline';
      }

      checkHealth();
      setInterval(checkHealth, 15000);
  </script>
</body>
</html>