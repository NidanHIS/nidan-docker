<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NidanEHR Services Portal</title>
  <style>
    /* ==========================================================================
       1. Global Styles & CSS Variables
       ========================================================================== */
    :root {
      --bg-color: #dbe3ea;
      --card-bg: #ffffff;
      --card-hover-bg: #f8fafc;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --primary-teal: #008080;
      
      --footer-bg: #008080;
      --footer-text: #ffffff;
      --footer-muted: rgba(255, 255, 255, 0.85);

      --status-online: #10b981;
      --status-checking: #f59e0b;
      --border-color: #e2e8f0;
      --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.03);
      --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
      width: 100%;
    }

    main {
      padding: 2rem 0 4rem;
      flex-grow: 1;
    }

    /* ==========================================================================
       2. Header Styling
       ========================================================================== */
        .header {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 2rem;
          width: 100%;
          margin: 20px 0 40px;
          /* Added background color, padding, and subtle styling */
          background-color: #ffffff;
          padding: 1.5rem 2rem;
          border-radius: 12px;
          box-shadow: var(--shadow-sm);
          border: 1px solid var(--border-color);
        }

        .brand-logo {
          width: 120px; /* Adjust as needed */
          height: auto;
          flex-shrink: 0;
        }

        .header-content {
          text-align: left;
        }

        .header-title {
          font-size: 1.4rem;
          font-weight: 700;
          color: var(--primary-teal);
          margin-bottom: 2px;
        }

        .header-sub {
          font-size: 1.1rem;
          font-weight: 600;
          color: #334155;
        }

        .header-sub-2 {
          font-size: 0.95rem;
          color: #64748b;
          margin-top: 2px;
        }

        .header-location {
          font-size: 1.3rem;
          font-weight: 700;
          margin-top: 6px;
          color: #0f172a;
        }

        .alt-location {
          color: #64748b;
          font-size: 0.9rem;
          margin-top: 2px;
        }

    @media (max-width: 768px) {
      .header {
        flex-direction: column;
        text-align: center;
        gap: 15px;
        margin: 20px 0;
      }

      .header-content {
        text-align: center;
      }

      .brand-logo {
        max-width: 120px;
      }
    }

    /* ==========================================================================
       3. Hero & Cards Grid Layout
       ========================================================================== */
    .hero-container {
      text-align: center;
      margin-bottom: 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.025em;
      line-height: 1.25;
      position: relative;
      display: inline-block;
    }

    .hero-title::after {
      content: '';
      display: block;
      width: 60px;
      height: 4px;
      background-color: var(--primary-teal);
      border-radius: 2px;
      margin: 0.85rem auto 0;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 1.75rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      border: 1px solid transparent;
      box-shadow: var(--shadow-sm);
      transition: var(--transition-smooth);
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      height: 100%;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
      border-color: rgba(0, 128, 128, 0.2);
      background: var(--card-hover-bg);
    }

    /* Status Badges */
    .status-badge {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      margin-bottom: 1.25rem;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }

    .status-badge.status-checking {
      background-color: rgba(245, 158, 11, 0.1);
      color: var(--status-checking);
    }

    .status-badge.status-online {
      background-color: rgba(16, 185, 129, 0.1);
      color: var(--status-online);
    }

    .icon-wrapper {
      width: 80px;
      height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
      transition: var(--transition-smooth);
    }

    .card:hover .icon-wrapper {
      transform: scale(1.06);
    }

    .icon-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .card-description {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.4;
      margin-top: auto;
    }

    /* ==========================================================================
       4. Powered By Tech Card
       ========================================================================== */
    .tech-card {
      align-items: center;
      text-align: center;
      grid-column: 1 / -1;
      padding: 1.5rem 1rem;
      cursor: default;
    }

    .tech-card:hover {
      transform: none;
      box-shadow: var(--shadow-sm);
      border-color: transparent;
      background: var(--card-bg);
    }

    .tech-card .card-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 0.25rem;
    }

    .tech-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      line-height: 1.4;
      max-width: 600px;
    }

    .tech-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1rem 2rem; /* Reduced gap */
      width: 100%;
    }

    .tech-logo {
      max-height: 24px; /* Reduced height for a subtle appearance */
      width: auto;
      object-fit: contain;
      filter: grayscale(100%); /* Pure black and white by default */
      opacity: 0.6; /* Slightly translucent */
      transition: var(--transition-smooth);
    }

    .tech-logo:hover {
      filter: grayscale(0%); /* Full color on hover */
      opacity: 1;
      transform: scale(1.05); /* Subtle scale effect */
    }

    /* ==========================================================================
       5. Footer
       ========================================================================== */
       footer {
         background-color: var(--footer-bg);
         padding: 1.25rem 0;
         color: var(--footer-text);
         font-size: 0.875rem;
       }

       .footer-content {
         display: flex;
         justify-content: space-between;
         align-items: center;
       }

       .footer-brand-link {
         display: inline-flex;
         align-items: center;
         gap: 0.4rem;
         text-decoration: none;
         color: inherit;
         vertical-align: middle;
       }

       .footer-logo {
         height: 1.1em; /* Matches the text line-height */
         width: auto;
         display: inline-block;
         vertical-align: middle;
       }

    @media (max-width: 640px) {
      .footer-content {
        flex-direction: column;
        gap: 0.5rem;
        text-align: center;
      }
    }
  </style>
</head>
<body>

  <!-- Main Content Area -->
  <main>
    <div class="container">
      
      <!-- Side-by-Side Header -->
      <header class="header">
        <img src="assets/images/nepal-gov-logo.png" alt="Nepal Government Logo" class="brand-logo">
        <div class="header-content">
          <div class="header-title">Lumbini Province Government</div>
          <div class="header-sub">Ministry of Health</div>
          <div class="header-sub-2">Health Directorate</div>
          <div class="header-location">Bhalubang Hospital</div>
          <div class="alt-location">Bhalubang, Dang</div>
        </div>
      </header>

      <!-- Hero Section -->
      <div class="hero-container">
        <h1 class="hero-title">Welcome to NidanEHR Services Portal</h1>
      </div>

      <!-- Grid of Services -->
      <div class="cards-grid">

        <!-- Card 1: Patient Registration & Billing (Odoo) -->
        <a href="${DASHBOARD_ODOO_URL}" target="_blank" class="card" id="card-odoo">
          <div class="status-badge status-checking" id="status-odoo">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/billing.png" alt="Patient Registration & Billing Icon" />
          </div>
          <h2 class="card-title">Patient Registration & Billing</h2>
        </a>

        <!-- Card 2: Electronic Health Record (OpenMRS) -->
        <a href="/openmrs/spa/index.html" target="_blank" class="card" id="card-openmrs">
          <div class="status-badge status-checking" id="status-openmrs">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/emr.png" alt="Electronic Health Record Icon" />
          </div>
          <h2 class="card-title">Electronic Health Record</h2>
        </a>

        <!-- Card 3: Laboratory Information System (OpenELIS) -->
        <a href="/openelis" target="_blank" class="card" id="card-openelis">
          <div class="status-badge status-checking" id="status-openelis">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/lab.png" alt="Laboratory Information System Icon" />
          </div>
          <h2 class="card-title">Laboratory Information System</h2>
        </a>

        <!-- Card 4: PACS & Diagnostic Imaging (Orthanc) -->
        <a href="/orthanc-container/ui/app/index.html#/" target="_blank" class="card" id="card-orthanc">
          <div class="status-badge status-checking" id="status-orthanc">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/pacs.png" alt="PACS & Diagnostic Imaging Icon" />
          </div>
          <h2 class="card-title">Radiology & Diagnostic Imaging</h2>
        </a>

        <!-- Card 5: Integration & Error Management (Middleware) -->
        <a href="/cis/dead-letters/index.html" target="_blank" class="card" id="card-cis">
          <div class="status-badge status-checking" id="status-cis">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/crisis.png" alt="Integration & Error Management Icon" />
          </div>
          <h2 class="card-title">Integration & Error Management</h2>
          <p class="card-description">Integration & eemps error data</p>
        </a>

        <!-- Card 6: Analytics & Business Intelligence (Superset) -->
        <a href="/superset/" target="_blank" class="card" id="card-superset">
          <div class="status-badge status-checking" id="status-superset">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/analytics.png" alt="Analytics & Business Intelligence Icon" />
          </div>
          <h2 class="card-title">Analytics & Business Intelligence</h2>
        </a>

        <!-- Card 7: Federal & Provincial HMIS Reporting (DHIS2) -->
        <a href="/dhis2/" target="_blank" class="card" id="card-dhis2">
          <div class="status-badge status-checking" id="status-dhis2">Checking...</div>
          <div class="icon-wrapper">
            <img src="assets/images/dhis2-report.png" alt="HMIS Reporting Icon" />
          </div>
          <h2 class="card-title">Federal & Provincial HMIS Reporting</h2>
        </a>

        <!-- Tech Stack Block -->
        <div class="card tech-card">
          <h2 class="card-title">Powered by Industry-Leading Technologies</h2>
          <p>Leveraging powerful open-source and enterprise technologies to deliver reliable, scalable solutions.</p>
          <div class="tech-list">
            <img src="assets/images/openmrs_logo.svg" alt="OpenMRS" class="tech-logo" />
            <img src="assets/images/OpenElisGlobalLogo.png" alt="OpenELIS Global" class="tech-logo" />
            <img src="assets/images/dhis2-logo.svg" alt="DHIS2" class="tech-logo" />
            <img src="assets/images/OrthancLogo.png" alt="Orthanc" class="tech-logo" />
            <img src="assets/images/odoo_logo.svg" alt="Odoo" class="tech-logo" />
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Footer -->
    <footer>
      <div class="container footer-content">
        <span>
          Powered by 
          <a href="https://trigonaltechnology.com/" target="_blank" class="footer-brand-link">
            <img src="trigonal-logo.png" alt="Trigonal Technology" class="footer-logo">
            <strong>Trigonal Technology</strong>
          </a>
        </span>
        <span>© 2026 NidanEHR. All rights reserved.</span>
      </div>
    </footer>
  <script>
      const services = [
          { id: 'openmrs', url: '/openmrs/spa/config.json' },
          { id: 'openelis', url: '/openelis/' },
          { id: 'odoo', url: '/odoo-health/' },
          { id: 'orthanc', url: '/auth-ping/orthanc' },
          { id: 'cis', url: '/cis/actuator/health' },
          { id: 'superset', url: '/superset/' },
          { id: 'dhis2', url: '/dhis2/auth/login' }
      ];

      async function checkHealth() {
          for (const service of services) {
              const card = document.getElementById(`card-${service.id}`);
              const statusBadge = document.getElementById(`status-${service.id}`);
              if (!card || !statusBadge) continue;

              try {
                  const response = await fetch(service.url, { method: 'GET', cache: 'no-cache' });
                  // NGINX returns 502/503/504 when the upstream container is down or starting
                  if (response.status === 502 || response.status === 503 || response.status === 504) {
                      setOffline(card, statusBadge);
                  } else {
                      // Any other status (including 401/404 redirects) means the backend container answered
                      setOnline(card, statusBadge);
                  }
              } catch (error) {
                  setOffline(card, statusBadge);
              }
          }
      }

      function setOnline(card, badge) {
          card.classList.remove('offline');
          badge.className = 'status-badge status-online';
          badge.innerText = 'Online';
      }

      function setOffline(card, badge) {
          card.classList.add('offline');
          badge.className = 'status-badge status-offline';
          badge.innerText = 'Offline';
      }

      // Run immediately, then poll every 15 seconds
      checkHealth();
      setInterval(checkHealth, 15000);
  </script>
</body>
</html>