<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>${NIDAN_BRAND_NAME}</title>
  <link rel="icon" href="/assets/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/assets/launcher.css">
  <link rel="stylesheet" href="/assets/brand/brand.css">
  <!-- ANALYTICS:BEGIN  opt-in: rendered only when GATEWAY_ANALYTICS_ID is set (public demo).
       Hospital installs leave it unset: no third-party script on the gateway origin (KC-04-04). -->
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=${GATEWAY_ANALYTICS_ID}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '${GATEWAY_ANALYTICS_ID}');
  </script>
  <!-- ANALYTICS:END -->
</head>

<body>

  <!-- Main Content Area -->
  <main>
    <div class="container">

      <!-- Brand Header -->
      <header class="header">
        <img src="/assets/brand/logo.svg" alt="" class="brand-logo">
        <div class="header-right">
          <!-- who is signed in + Sign out + Change password (launcher.js; textContent only) -->
          <div class="identity-line" id="identity-line" data-keycloak="${KEYCLOAK_PUBLIC_URL}" data-logout-all="${NIDAN_APP_LOGOUT_ENDS_ALL}" hidden></div>
          <label class="locale-picker"><span data-i18n="locale.label">Language</span>
            <select id="locale-picker" aria-label="Language"><option value="en">English</option><option value="ne">नेपाली</option></select>
          </label>
        </div>
      </header>

      <!-- Hero Section -->
      <div class="hero-container">
        <h1 class="hero-title" data-i18n="launcher.title">Welcome to NidanEHR Services Portal</h1>
      </div>

      <div id="launcher-messages"></div>

      <!-- Grid of Services -->
      <div class="cards-grid">

        <!-- OpenMRS -->
        <a href="/openmrs/spa" target="nidan-openmrs" rel="noopener" class="card" id="card-openmrs">
          <div class="status-badge status-checking" id="status-openmrs">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/emr.png" alt="Electronic Medical Record Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.openmrs">Electronic Medical Record</h2>
        </a>

        <!-- OpenELIS -->
        <a href="/openelis" target="nidan-openelis" rel="noopener" class="card" id="card-openelis">
          <div class="status-badge status-checking" id="status-openelis">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/lab.png" alt="Laboratory Information System Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.openelis">Laboratory Information System</h2>
        </a>

        <!-- Odoo -->
        <a href="${DASHBOARD_ODOO_URL}" target="nidan-odoo" rel="noopener" class="card" id="card-odoo">
          <div class="status-badge status-checking" id="status-odoo">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/billing.png" alt="ERP & Inventory Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.odoo">ERP &amp; Inventory</h2>
        </a>

        <!-- Orthanc -->
        <a href="/orthanc-container/ui/app/index.html#/" target="nidan-orthanc" rel="noopener" class="card" id="card-orthanc">
          <div class="status-badge status-checking" id="status-orthanc">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/pacs.png" alt="PACS &amp; Imaging Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.orthanc">PACS &amp; Imaging (Explorer 2)</h2>
        </a>

        <!-- Middleware UI -->
        <a href="/cis/dead-letters/index.html" target="nidan-cis" rel="noopener" class="card" id="card-cis">
          <div class="status-badge status-checking" id="status-cis">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/crisis.png" alt="Integration &amp; Error Management Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.cis">Integration &amp; Error Management</h2>
        </a>

        <!-- Superset -->
        <a href="/superset/" target="nidan-superset" rel="noopener" class="card" id="card-superset">
          <div class="status-badge status-checking" id="status-superset">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/analytics.png" alt="Analytics &amp; Business Intelligence Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.superset">Analytics &amp; Business Intelligence</h2>
        </a>

        <!-- DHIS2 -->
        <a href="/dhis2/" target="nidan-dhis2" rel="noopener" class="card" id="card-dhis2">
          <div class="status-badge status-checking" id="status-dhis2">Checking...</div>
          <div class="icon-wrapper">
            <img src="/assets/images/dhis2-report.png" alt="HMIS Reporting Icon" />
          </div>
          <h2 class="card-title" data-i18n="card.dhis2">Federal &amp; Provincial HMIS Reporting</h2>
        </a>

        <!-- DEMO:BEGIN  public demo only: shown when GATEWAY_SHOW_DEMO_CREDENTIALS=true (KC-04-01) -->
        <!-- Demo Credentials -->
        <a href="#" class="card" id="credentialBtn">
          <div class="icon-wrapper">🔑</div>
          <h2 class="card-title">Demo Credentials</h2>
          <p class="card-description">Click here to view login details</p>
        </a>
        <!-- DEMO:END -->

      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container footer-content">

      <!-- Left Side: Single Line Open Source Powerhouse Logos -->
      <div class="footer-left">
        <div class="tech-powerhouse">
          <span class="tech-powerhouse-title" data-i18n="footer.tech">Open Source Powerhouse</span>
          <div class="tech-list-small">
            <img src="/assets/images/openmrs_logo.svg" alt="OpenMRS" class="tech-logo-small" />
            <img src="/assets/images/OpenElisGlobalLogo.png" alt="OpenELIS Global" class="tech-logo-small" />
            <img src="/assets/images/dhis2-logo.svg" alt="DHIS2" class="tech-logo-small" />
            <img src="/assets/images/OrthancLogo.png" alt="Orthanc" class="tech-logo-small" />
            <img src="/assets/images/odoo_logo.svg" alt="Odoo" class="tech-logo-small" />
          </div>
        </div>
      </div>

      <!-- Right Side: Powered By & Copyright -->
      <div class="footer-right">
        <span>
          <span data-i18n="footer.poweredBy">Powered by</span>
          <a href="https://trigonaltechnology.com/" target="_blank" class="footer-brand-link">
            <img src="/trigonal-logo.png" alt="Trigonal Technology" class="footer-logo">
            <strong>Trigonal Technology</strong>
          </a>
        </span>
        <span class="copyright-text" data-i18n="footer.rights">© 2026 NidanEHR. All rights reserved.</span>
      </div>

    </div>
  </footer>

  <!-- DEMO:BEGIN -->
  <!-- Demo Credentials Modal -->
  <div class="credential-modal" id="credentialModal">
    <div class="credential-content">
      <button class="close-btn" id="closeCredential">&times;</button>

      <h2>Demo Credentials</h2>
      <p>Select the application and use the credentials below.</p>

      <div class="credential-grid">

        <div class="credential-item">
          <h3>🏢 Odoo ERP</h3>
          <span>Username</span>
          <code>nidan</code>

          <span>Password</span>
          <code>nidan</code>
        </div>

        <div class="credential-item">
          <h3>🏥 OpenMRS</h3>
          <span>Username</span>
          <code>admin</code>

          <span>Password</span>
          <code>Admin123</code>
        </div>

        <div class="credential-item">
          <h3>🔬 OpenELIS</h3>
          <span>Username</span>
          <code>admin</code>

          <span>Password</span>
          <code>adminADMIN!</code>
        </div>

        <div class="credential-item">
          <h3>📊 Superset</h3>
          <span>Username</span>
          <code>admin</code>

          <span>Password</span>
          <code>admin</code>
        </div>

        <div class="credential-item">
          <h3>📡 DHIS2</h3>
          <span>Username</span>
          <code>admin</code>

          <span>Password</span>
          <code>Admin@123#!</code>
        </div>

        <div class="credential-item">
          <h3>🦴 Orthanc</h3>
          <span>Username</span>
          <code>nidan</code>

          <span>Password</span>
          <code>nidan</code>
        </div>

      </div>
    </div>
  </div>
  <!-- DEMO:END -->


  <script src="/assets/i18n.js" defer></script>
  <script src="/assets/launcher.js" defer></script>
</body>

</html>
