{
    "Name": "Nidan Orthanc",
    "PostgreSQL": {
        "Enable": true,
        "Host": "${ORTHANC_DB_HOST:-orthanc-db}",
        "Port": 5432,
        "Database": "${ORTHANC_DB_NAME:-orthanc}",
        "Username": "${ORTHANC_DB_USER:-orthanc}",
        "Password": "${ORTHANC_DB_PASSWORD:-orthanc}"
    },
    "Plugins": [
        "/usr/share/orthanc/plugins-available/libOrthancExplorer2.so"
    ],
    "RemoteAccessAllowed": true,
    "AuthenticationEnabled": true,
    "RegisteredUsers": {
        "${ORTHANC_USERNAME:-nidan}": "${ORTHANC_PASSWORD:-nidan}"
    }
}