#!/bin/sh
# Enable once per clone: git config core.hooksPath scripts/git-hooks   (backlog KC-05-07)
if git diff --cached --name-only | grep -qx '.env'; then
  python3 -I scripts/check-demo-env.py --staged || exit 1
fi
if git diff --cached --name-only | grep -q '\(^\|/\)\.env\.local$'; then
  echo ".env.local holds site secrets and must never be committed" >&2
  exit 1
fi
