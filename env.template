# ── Backup encryption (S-10.2) ─────────────────────────────────────────────
# Volume backups are encrypted with age. There is no unencrypted mode: a
# missing recipient is a hard failure, because a backup that silently degrades
# to plaintext is worse than one that fails loudly.
#
# Generate a keypair:  ./scripts/volume-backup.sh keygen ~/nidan-backup-key.txt
#
# The recipient is a PUBLIC key and is safe here. The identity is a path — the
# private key file itself must live outside this machine as well, or the fire
# that takes the server takes the only means of reading its backups. Custody is
# docs/RUNBOOK-backup-key-management.md and it has fields you must fill in.
BACKUP_AGE_RECIPIENT=CHANGEME_GENERATE_ME
BACKUP_AGE_IDENTITY=/path/to/nidan-backup-key.txt

# ── Patient portal (optional; off unless you set it up) ────────────────────
# The portal is a SEPARATE deployment. Nothing here starts it: these are the
# properties this stack needs so the portal's on-premise worker can read from
# it, and so the hospital can turn that access off.
#
# The worker (portal-sync) runs beside this stack, reads the Kafka bus and the
# OpenMRS FHIR API, encrypts per patient, and pushes outbound to the cloud. The
# cloud never opens a connection into this network — see
# nidan-patient-portal/deploy/outbound-only-test, which proves it with a packet
# capture rather than an assertion.
#
# Leaving PORTAL_ENABLED at false is a complete answer: no account is created,
# nothing is published, and nothing about this stack changes.
PORTAL_ENABLED=false

# Which hospital this deployment is. Must match the CN of the client
# certificate the worker presents, because the receiver compares the two and
# answers 403 on a mismatch — a typo here surfaces as a permissions failure
# rather than a configuration one.
PORTAL_HOSPITAL_ID=CHANGEME_HOSPITAL_ID

# Read-only OpenMRS account the worker authenticates as for the fhir2
# observation pull. A dedicated account, not admin: the portal needs a handful
# of concepts and nothing else, and a leaked sync credential should not carry
# clinical write access. fhir2 answers 401 to an anonymous request, so a blank
# password makes every pull look like an EHR outage rather than a misconfigured
# one.
PORTAL_FHIR_USERNAME=nidan-portal-sync
PORTAL_FHIR_PASSWORD=CHANGEME_GENERATE_ME

# Which observation concepts may leave the building, comma-separated concept
# UUIDs. This list is the data-minimisation control: it is sent to OpenMRS as a
# server-side filter, so a concept absent from it is never read at all rather
# than read and discarded. An empty list disables observation pulling entirely,
# which is a legitimate choice — a hospital may want appointments and bills in
# the portal and no observations.
PORTAL_OBSERVATION_ALLOWLIST=

# Kafka group the worker consumes under. Distinct from CIS's and OIS's groups
# so the portal reads the same topics without competing with them for
# partitions.
PORTAL_KAFKA_GROUP=portal-sync

# Whether Odoo publishes appointment events at all. Read by
# nidan_appointment_sync_gate; absent means enabled, and only an explicit false
# turns it off. Set through Settings in Odoo, or here for a fresh deployment.
PORTAL_PUBLISH_APPOINTMENTS=true
