PROVINCIAL_DHIS2_USERNAME=
PROVINCIAL_DHIS2_PASSWORD=
PROVINCIAL_DHIS2_SSL_VERIFY=true
PROVINCIAL_DHIS2_ORG_UNIT=


# Superset
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_LOAD_EXAMPLES=no
# Superset seeds DB connections from these vars (OpenMRS, OpenELIS, Odoo)
# Uses OPENMRS_DB_*, OPENELIS_DB_*, ODOO_DB_* from above
SUPERSET_IMAGE=


# Debezium Embedded (CIS) - CDC for OpenMRS changes
DEBEZIUM_ENABLED=true
DEBEZIUM_DB_USER=root
DEBEZIUM_DB_PASSWORD=openmrs
DEBEZIUM_TABLE_INCLUDE_LIST=openmrs.orders,openmrs.person,openmrs.person_name,openmrs.patient_identifier

# Kafka retry topics (opt-in via @KafkaRetryable)
INTEGRATION_KAFKA_RETRY_ENABLED=true
INTEGRATION_KAFKA_RETRY_ATTEMPTS=5
INTEGRATION_KAFKA_RETRY_INITIAL_DELAY=5s
INTEGRATION_KAFKA_RETRY_MULTIPLIER=2.0
INTEGRATION_KAFKA_RETRY_MAX_DELAY=10m
CIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-cis-retry
CIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.cis.DLT
OIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-ois-retry
OIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.ois.DLT

# Odoo secrets for OIS integration
NIDAN_ODOO_SECRET=your-secret-key
ODOO_NIDAN_SECRET=your-secret-key
OIS_WEBHOOK_SECRET=your-secret-key