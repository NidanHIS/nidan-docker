# ── Backup encryption (S-10.2) ─────────────────────────────────────────────
# Volume backups are encrypted with age. There is no unencrypted mode: a
# missing recipient is a hard failure, because a backup that silently degrades
# to plaintext is worse than one that fails loudly.
#
# Generate a keypair:  ./scripts/volume-backup.sh keygen ~/nidan-backup-key.txt
#
# The recipient is a PUBLIC key and is safe here. The identity is a path — the
# private key file itself must live outside this machine as well, or the fire
# that takes the server takes the only means of reading its backups. Custody is
# docs/RUNBOOK-backup-key-management.md and it has fields you must fill in.
BACKUP_AGE_RECIPIENT=CHANGEME_GENERATE_ME
BACKUP_AGE_IDENTITY=/path/to/nidan-backup-key.txt

# ----------------------------------------------------------------------------
# Optional overrides (KC-29-01). Commented out = the compose default shown is used.
# ----------------------------------------------------------------------------
# Central login: OAuth2 token URL for machine callers when OPENMRS_AUTH_MODE=jwt (default: the gateway's
# internal Keycloak back-channel, KC-43)
# OPENMRS_AUTH_TOKEN_URL=http://gateway:8099/auth/realms/nidan/protocol/openid-connect/token
# Superset embedded dashboards; empty = guest tokens off (fail closed)
# SUPERSET_GUEST_TOKEN_SECRET=
# Launcher: show the demo login cards (public demo only, never a hospital)
# GATEWAY_SHOW_DEMO_CREDENTIALS=false
# DHIS2 integration bootstrap admin username (reserved in Keycloak, KC-55)
# DHIS2_ADMIN_USERNAME=admin
# Internal hostnames / paths
# CIS_HOST=nidan-cis
# OPENELIS_DB_HOST=openelis-db
# OPENELIS_DB_PORT=5432
# OPENELIS_CONTEXT_PATH=/api/OpenELIS-Global/
# OPENELIS_FHIR_BASE_URL=http://openelis-fhir:8080
# OPENELIS_ORDER_BUNDLE_PATH=/fhir/tasks
# OpenMRS JVM memory
# OMRS_JAVA_MEMORY_OPTS=-Xmx1536m -Xms512m -XX:MaxMetaspaceSize=512m
# Kafka client/broker tuning (defaults suit one host)
# KAFKA_CONSUMER_FETCH_MAX_WAIT_MS=500
# KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=600000
# KAFKA_CONTROLLER_SOCKET_TIMEOUT_MS=60000
# KAFKA_METADATA_MAX_AGE_MS=300000
# KAFKA_PRODUCER_LINGER_MS=5
# KAFKA_RECONNECT_BACKOFF_MS=500
# KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
# KAFKA_REPLICA_SOCKET_TIMEOUT_MS=60000
# KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=102400
# KAFKA_SOCKET_SEND_BUFFER_BYTES=102400
# KAFKA_SOCKET_REQUEST_MAX_BYTES=104857600
# Local development only (dev.docker-compose.yml)
# ODOO_ADDONS_PATH=../odoo_19_addons
# ODOO_PAYMENT_ADDONS_HOST_PATH=../odoo_payment_gateway
# TAG=qa

# ----------------------------------------------------------------------------
# DICOM lockdown (KC-31). List every modality that sends to / queries Orthanc, then set
# ORTHANC_DICOM_ALLOW_ANY_STORE=false (production preflight requires both).
#   ORTHANC_DICOM_MODALITIES={"CT1":{"AET":"CT1","Host":"192.168.10.21","Port":104,"AllowStore":true,"AllowFind":true,"AllowMove":true,"AllowEcho":true}}
# ----------------------------------------------------------------------------
ORTHANC_DICOM_MODALITIES=
# ORTHANC_DICOM_ALLOW_ANY_STORE=true
# DICOM_BIND_IP=0.0.0.0
# DICOM_MODALITY_CIDR=192.168.10.0/24     (scripts/dicom-firewall.sh)

# ----------------------------------------------------------------------------
# Read-only reporting login for Superset and the DHIS2 app (KC-48). Until set, they use the apps' own
# full-privilege DB accounts. Set BOTH together, after scripts/reporting-db-users.py --apply created the user
# with the same password (production preflight refuses until reporting uses nidan_reporting).
# ----------------------------------------------------------------------------
# REPORTING_DB_USER=nidan_reporting
# REPORTING_DB_PASSWORD=
