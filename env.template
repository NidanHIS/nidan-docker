# DHIS2 / FEDERAL HMIS INTEGRATION
# ============================================================================
DHIS2_APP_PORT=5000
DHIS2_SECRET_KEY=change-me-to-a-long-random-string
DHIS2_DEBUG=false
DHIS2_FLASK_ENV=production
DHIS2_AUTH_PROVIDER=env_file
DHIS2_REPORTER_USERNAME=reporter
DHIS2_REPORTER_PASSWORD=change-me
DHIS2_DB_CONNECT_TIMEOUT=10
DHIS2_DB_DATE_OVERLAP_BUFFER_DAYS=2

# DHIS2 dedicated MySQL DB
DHIS2_DB_NAME=nidan_dhis2
DHIS2_DB_USER=nidan
DHIS2_DB_PASSWORD=reporter
DHIS2_DB_ROOT_PASSWORD=reporter
DHIS2_DB_HOST=nidan-dhis2-db
DHIS2_DB_PORT=3306

# Federal HMIS Nepal
FEDERAL_HMIS_URL=https://hmis.gov.np/hmis
FEDERAL_HMIS_USERNAME=hospitalcode
FEDERAL_HMIS_PASSWORD=change-me
