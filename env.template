# (loop prevention). Keep these equal to NIDAN_SYNC_USERNAME / NIDAN_SYNC_PASSWORD.
OPENMRS_USERNAME=nidan-sync
OPENMRS_PASSWORD=CHANGEME_GENERATE_ME
# Real OpenMRS admin — used ONLY by CIS at startup to bootstrap (create the sync account).
OPENMRS_ADMIN_USERNAME=admin
OPENMRS_ADMIN_PASSWORD=CHANGEME_GENERATE_ME
OPENMRS_IDENTIFIER_TYPE_UUID=c0e1d2f3-a4b5-4c6d-9e0f-1a2b3c4d5e6f
OPENMRS_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
OPENMRS_FHIR_EXTENSION_URL=http://fhir.openmrs.org/ext/patient/identifier#location
# Encounter type used to anchor order-less (Odoo-billed / walk-in) lab results that CIS ingests
# from OpenELIS into OpenMRS. Default = the stock "Lab Results" encounter type.
OPENMRS_LAB_RESULTS_ENCOUNTER_TYPE_UUID=3596fafb-6f6f-4396-8c87-6e63a0f1bd71
# Concept set whose members O3's order basket lists as orderable lab tests. The CIS lab-catalog
# sync adds each newly-synced test concept to this set so it becomes orderable in OpenMRS.
OPENMRS_LAB_ORDERABLES_CONCEPT_SET_UUID=1748a953-d12e-4be1-914c-f6b096c6cdef

# ── Integration sync service account (bidirectional-sync LOOP PREVENTION) ───────────────
# A single dedicated account provisioned by the middleware on startup — CIS creates it in OpenMRS
