# =============================================================================
# Nidan Docker — environment template
# Copy to .env.local (untracked), then run scripts/generate-secrets.sh --fresh-install.
# Variable names and section order match the tracked demo .env for easy diffing.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment mode and central login (Keycloak IAM spec §3; backlog KC-01-04)
# -----------------------------------------------------------------------------
# production = a real hospital site: scripts/preflight.py, CIS/OIS, Superset and the DHIS2 app then
# refuse demo/short secrets. Leave empty only for the public demo.
NIDAN_DEPLOYMENT=production
# Central login. Stays false until the SSO stories ship (KC-27); flipping it is a runbook, not a toggle.
NIDAN_SSO_ENABLED=false
# Per-app overrides; empty = follow NIDAN_SSO_ENABLED.
OPENMRS_SSO_ENABLED=
OPENELIS_SSO_ENABLED=
SUPERSET_SSO_ENABLED=
# How CIS/OIS authenticate to OpenMRS: basic today, jwt once OpenMRS SSO is on (a mismatch is fatal).
OPENMRS_AUTH_MODE=basic
# DICOM listener (KC-31): host interface for port 4242 and the modality subnet allowed to reach it.
DICOM_BIND_IP=
DICOM_MODALITY_CIDR=
# Shown on the outage page (ds5) and the default UI language (en | ne).
SUPPORT_PHONE=
DEFAULT_LOCALE=en
# Hospital branding (logo, colours, launcher texts) for the launcher and the Keycloak login page: a folder laid out
# like proxy/assets/brand (see its README.md). Empty = the Nidan default.
NIDAN_BRANDING_DIR=
# Hospital name in page and login tab titles (plain text). Empty = "Nidan EHR".
NIDAN_BRAND_NAME=
# Shared PCs: true = logging out of ANY app signs the person out of everything (Keycloak login page). Default false:
# an app logout returns to the launcher and keeps the person's other apps open, unless it was their only app.
NIDAN_APP_LOGOUT_ENDS_ALL=false
# Email / SMS sign-in codes (optional second step). Each channel is off until set; a person turns it on from the
# launcher ("Two-step sign-in"), codes go to the email / phone a hospital admin entered on the Staff page.
# Email: any SMTP server (e.g. the hospital's mail provider).
NIDAN_SMTP_HOST=
NIDAN_SMTP_PORT=587
NIDAN_SMTP_FROM=
NIDAN_SMTP_STARTTLS=true
NIDAN_SMTP_AUTH=true
NIDAN_SMTP_USER=
NIDAN_SMTP_PASSWORD=
# SMS: sparrow (Sparrow SMS) | aakash (Aakash SMS) | webhook (POST JSON {to, text}, Bearer token, to NIDAN_SMS_URL)
# | none. NIDAN_SMS_URL also overrides the Sparrow/Aakash API URL. NIDAN_SMS_FROM = Sparrow sender identity.
NIDAN_SMS_PROVIDER=none
NIDAN_SMS_URL=
NIDAN_SMS_TOKEN=
NIDAN_SMS_FROM=
# Optional Google Analytics id for the public demo launcher only; empty = no third-party script.
GATEWAY_ANALYTICS_ID=
# Dead-letter page/API login user (password: DEAD_LETTER_ADMIN_PASSWORD below).
DEAD_LETTER_ADMIN_USERNAME=dead-letter-admin

# -----------------------------------------------------------------------------
# Gateway & TLS (Let's Encrypt via certbot)
# -----------------------------------------------------------------------------
GATEWAY_IMAGE=trigonaltechnology/gateway:latest
GATEWAY_DOMAIN=localhost
# Extra hostnames/IPs to put in the self-signed certificate, comma separated.
# Whatever users type in the address bar must be listed or the browser warns.
# Leave blank when GATEWAY_DOMAIN is a real domain with a Let's Encrypt cert.
# Every OTHER name or IP staff type to reach the gateway (e.g. DNS:ehr.lan,IP:192.168.1.10). The gateway
# answers only GATEWAY_DOMAIN, localhost, 127.0.0.1 and these; any other Host gets 421 (KC-56-06).
GATEWAY_CERT_SANS=
# Staff page jobs (scripts/staff-config.py output); empty dir = no jobs, no job changes.
# STAFF_SITE_DIR=./proxy/staff-site
# HSTS: auto = only for a DNS name with a publicly issued certificate (never bare IP / self-signed / site CA)
# GATEWAY_HSTS=auto
# Odoo link on the gateway dashboard (index.html Odoo card).
# Odoo is served by the gateway on https://<host>:8069; empty = https://<GATEWAY_DOMAIN>:8069
DASHBOARD_ODOO_URL=
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAINS=localhost

# -----------------------------------------------------------------------------
# TLS trust / keystores (optional; FHIR or HTTPS clients)
# -----------------------------------------------------------------------------
SSL_TRUSTSTORE_PATH=
SSL_TRUSTSTORE_PASSWORD=CHANGEME_GENERATE_ME
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=CHANGEME_GENERATE_ME

